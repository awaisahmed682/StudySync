# Neon PostgreSQL connection string (Postgres 15/16/17)
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@EP-HOST.aws.neon.tech/studysync?sslmode=require"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-32-byte-secret"
