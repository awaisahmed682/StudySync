# Neon PostgreSQL connection string (Postgres 15/16/17)
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@EP-HOST.aws.neon.tech/studysync?sslmode=require"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-32-byte-secret"

# Email notifications. Two options — SMTP is preferred (delivers to any recipient).
#
# Option 1 — SMTP (recommended): sends to every user's inbox.
# Gmail example: HOST=smtp.gmail.com, PORT=465, USER=<your gmail>, PASS=<16-char App Password>
# (App Password: Google Account -> Security -> 2-Step Verification -> App passwords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
# Optional display sender, e.g. "StudySync <you@gmail.com>". Defaults to "StudySync <SMTP_USER>".
# EMAIL_FROM="StudySync <you@gmail.com>"

# Option 2 — Resend: only delivers to the account owner until you verify a domain.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY="re_xxxx"
